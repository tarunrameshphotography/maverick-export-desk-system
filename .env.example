# Copy to .env and fill in. Never commit the real .env file.

# Path overrides (optional — defaults are relative to the radar/ package)
RADAR_DB_PATH=data/radar.db
RADAR_DATA_DIR=data

# Required for `content-generate` (radar/content/generation.py, Phase 2
# Content Engine) — direct API calls to write the finished LinkedIn/
# Instagram bundle, grounded only in verified claims. Not required for
# collection, verification, scoring, angle selection, or `content-bundle`
# (the scaffold-only command), and not required to run the test suite.
# ANTHROPIC_API_KEY=

# Optional: model id for content generation. Defaults to claude-sonnet-5.
# RADAR_CONTENT_MODEL=

# Optional: Federal Register API has no key requirement, listed for clarity.
# FEDERAL_REGISTER_API_BASE=https://www.federalregister.gov/api/v1

# Optional: enables automated UN Comtrade trade-value lookups on the Desk
# Sheet's exposure line. Without it, the Desk Sheet links to a manual lookup
# instead of fabricating a number. Free key: https://comtradeplus.un.org/
# COMTRADE_API_KEY=
