# Copy to .env and fill in. Never commit the real .env file.

# Path overrides (optional — defaults are relative to the radar/ package)
RADAR_DB_PATH=data/radar.db
RADAR_DATA_DIR=data

# Optional, v2: only needed if/when the pipeline is switched from the
# hybrid (Claude Code interactive) mode to direct API calls for
# triage/verification/angle/draft generation. Not required to run v1.
# ANTHROPIC_API_KEY=

# Optional: Federal Register API has no key requirement, listed for clarity.
# FEDERAL_REGISTER_API_BASE=https://www.federalregister.gov/api/v1
